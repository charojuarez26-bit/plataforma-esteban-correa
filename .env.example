# Configuración de Supabase para Esteban Correa Personal Trainer
# Reemplaza con los valores de tu proyecto en Supabase (Settings -> API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# WhatsApp del Coach (con código de país, ej. 54911xxxxxxxx para Argentina)
VITE_COACH_WHATSAPP=5491123456789
